# VM .env — non-secret config + optional fallbacks for backup/seed scripts.
# Database and staging passwords live in Vault (secret/odoo/*) after Phase 6.
# One-time: ./scripts/vault-seed-secrets.sh  then  ./scripts/install-external-secrets.sh

DB_HOST=psql-odoo-devops-lab.postgres.database.azure.com
DB_USER=odooadmin
DB_PORT=5432

# Only needed until backup.sh reads Vault — prefer secret/odoo/backup in Vault
# DB_PASSWORD=
# AZURE_STORAGE_KEY=

# Host docker group GID — run on VM: getent group docker | cut -d: -f3
DOCKER_GID=999

# Azure Blob backups — account/container names (key in Vault secret/odoo/backup)
AZURE_STORAGE_ACCOUNT=stodoodevopslab
AZURE_STORAGE_CONTAINER=odoo-backups
ODOO_DB_NAME=odoo_devops_lab
