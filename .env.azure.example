# Copy on the Azure VM: cp .env.azure.example .env
# Use DB_* names — USER/PASSWORD clash with shell vars under sudo

DB_HOST=psql-odoo-devops-lab.postgres.database.azure.com
DB_USER=odooadmin
DB_PASSWORD=admin
DB_PORT=5432

# Host docker group GID — run on VM: getent group docker | cut -d: -f3
DOCKER_GID=999

# Azure Blob backups — from: cd terraform && terraform output
AZURE_STORAGE_ACCOUNT=stodoodevopslab
AZURE_STORAGE_CONTAINER=odoo-backups
AZURE_STORAGE_KEY=paste-from-terraform-output-raw-storage_primary_access_key
ODOO_DB_NAME=odoo_devops_lab

# Staging Postgres runs on VM (k3s pod) — not Azure. See docs/k3s/README.md
# STAGING_DB_USER=odoo
# STAGING_DB_PASSWORD=odoo-staging-change-me
