# Copy to .env in repo root (gitignored). Used by scripts/ on your laptop or CI runner with kubectl + az.

# Production Azure PostgreSQL (private FQDN from: terraform output -raw postgres_fqdn)
POSTGRES_FQDN=psql-odoo-devops-lab-xxxx.postgres.database.azure.com
DB_USER=odooadmin
DB_PASSWORD=
DB_PORT=5432

# In-cluster staging Postgres (helm/postgres-staging) — not Azure
STAGING_DB_USER=odoo_staging
STAGING_DB_PASSWORD=
ODOO_STAGING_DB_NAME=odoo_staging

# Production Odoo DB name
ODOO_DB_NAME=odoo_devops_lab

# Azure Blob (terraform output storage_account_name)
AZURE_STORAGE_ACCOUNT=stodoodevopslab
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=odoo-backups
ODOO_PROD_FILESTORE_CONTAINER=odoo-prod-filestore
ODOO_STAGING_FILESTORE_CONTAINER=odoo-staging-filestore

# Optional
# ODOO_NAMESPACE=odoo
# KUBECONFIG=~/.kube/config
