# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored — do not commit it.

location             = "eastus"
resource_group_name  = "rg-odoo-devops-lab"
vm_name              = "vm-odoo-lab"
vm_size              = "Standard_B1ms"
admin_username       = "azureuser"

# Paste: cat ~/.ssh/azure_vm_key.pub  (must be ssh-rsa — Azure rejects ed25519)
admin_ssh_public_key = "ssh-rsa AAAA... your-key ..."

# Safer: only your IP can SSH. Find IP: curl -s ifconfig.me
# allowed_ssh_cidr = "1.2.3.4/32"

# Step 2 — Azure PostgreSQL (private, same VNet as VM)
postgres_server_name      = "psql-odoo-devops-lab"
postgres_admin_login      = "odooadmin"
postgres_admin_password   = "admin"
postgres_database_name    = "odoo_devops_lab"
postgres_sku_name         = "B_Standard_B1ms"

# Step 4 — Azure Blob backups (globally unique name)
storage_account_name = "stodoodevopslab"
