# Copy to terraform.tfvars (gitignored):
#   cp terraform.tfvars.example terraform.tfvars

location            = "eastus"
resource_group_name = "rg-odoo-devops-lab"

aks_cluster_name   = "aks-odoo-devops-lab"
aks_node_vm_size   = "Standard_D4s_v5"
# Fixed 2-VM node pool (no scale-out beyond 2 workers)
aks_node_min_count = 2
aks_node_max_count = 2

postgres_server_name           = "psql-odoo-devops-lab-UNIQUE"
postgres_admin_login           = "odooadmin"
postgres_admin_password        = "CHANGE-ME-strong-password"
postgres_database_name = "odoo_devops_lab"
postgres_sku_name              = "GP_Standard_D2s_v3"
postgres_ha_enabled              = false

storage_account_name = "stodoodevopslabUNIQUE"
